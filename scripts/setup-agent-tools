#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

mkdir -p .claude

if [[ -L ".claude/skills" ]]; then
  TARGET="$(readlink ".claude/skills")"
  if [[ "$TARGET" == "../.agents/skills" ]]; then
    echo "Claude skills symlink already configured."
    exit 0
  fi

  echo "ERROR: .claude/skills is already a symlink to: $TARGET"
  exit 1
fi

if [[ -e ".claude/skills" ]]; then
  echo "ERROR: .claude/skills already exists and is not a symlink."
  echo "Move/merge it manually before running this script."
  exit 1
fi

ln -s ../.agents/skills .claude/skills

echo "Configured .claude/skills -> ../.agents/skills"
echo "Canonical portable skills remain in .agents/skills."
